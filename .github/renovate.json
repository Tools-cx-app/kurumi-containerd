{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust-dependencies",
      "rangeStrategy": "bump"
    }
  ],
  "ignoreDeps": [
    "taiki-e/install-action"
  ],
  "automerge": true,
  "automergeType": "pr",
  "skipArtifactsUpdate": true,
  "constraints": {
    "rust": "nightly"
  }
}
